{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm test && npm run typecheck && npm run build",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "functions": {
    "app.mjs": {
      "includeFiles": "{dist/**,node_modules/swagger-ui-dist/{swagger-ui.css,swagger-ui-bundle.js,package.json}}"
    }
  }
}
